# Copy this file to .env for local `vercel dev` testing. On Vercel itself,
# set these as real Environment Variables in Project Settings — never commit
# actual values to this repo.

# From https://resend.com/api-keys — created after you sign up and verify
# your sending domain (pandasportsmemorabilia.com) in the Resend dashboard.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# The ID of the Resend contact list signups get added to. Resend has been
# renaming "Audiences" to "Segments" in newer dashboards — same feature,
# create one either way and copy its ID here.
RESEND_AUDIENCE_ID=00000000-0000-0000-0000-000000000000

# Optional — where the "someone just signed up" notification email goes.
# Defaults to support@pandasportsmemorabilia.com if you don't set this.
RESEND_NOTIFY_TO=support@pandasportsmemorabilia.com

# Optional — the From address on that notification email. info@ is the
# convention this site uses for anything automated the system sends;
# support@ is where a human reads replies. The domain part must be verified
# in Resend. Defaults to the value shown here if unset.
RESEND_FROM=Panda Sports Memorabilia <info@pandasportsmemorabilia.com>

# --- Shop & ordering (Stripe) -------------------------------------------

# From https://dashboard.stripe.com/apikeys — the SECRET key (starts
# sk_live_ / sk_test_), not the publishable one. Test mode has its own
# separate key and its own separate Products/Customers/Invoices, so
# nothing you list or charge in test mode shows up once you switch to the
# live key, and vice versa.
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_OWN_KEY

# The matching PUBLISHABLE key (starts pk_live_ / pk_test_) from the same
# page. Not a secret — api/config.js hands it straight to the browser so
# Stripe.js can render the card field on the reservation form — but it
# still lives here rather than being hardcoded, so switching test/live
# mode is a Vercel setting, not a code change. Must be from the same mode
# (test or live) as STRIPE_SECRET_KEY above, or card collection will fail.
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_OWN_KEY

# No webhook is needed for the reserve-an-item flow — see the "Reserve
# now, save the card, charge on ship" section of the README for why, and
# for how buyers actually get charged (a card saved at reservation via
# Stripe's own embedded field, charged automatically once the order ships
# — the raw card number never touches this server, only Stripe's).
